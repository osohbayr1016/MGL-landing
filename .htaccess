RewriteEngine on


AddDefaultCharset UTF-8

Options All -Indexes


RewriteRule ^home(/?) index.php?incPageType=home [L]

RewriteRule ^n/([0-9]+)(/?)+$ index.php?incPageType=news&subPage=view&newsID=$1 [L]

RewriteRule ^page/([0-9]+)(/?)+$ index.php?incPageType=page&pageID=$1&$2 [QSA]
RewriteRule ^page/([0-9]+)/([0-9]+)(/?)+$ index.php?incPageType=page&pageID=$1&objID=$2 [L]

RewriteRule ^tour/([^/]+)(/?) index.php?incPageType=tour&subPage=more&tourID=$1 [L]

RewriteRule ^destination/([^/]+)(/?) index.php?incPageType=destinations&subPage=more&destID=$1 [L]

RewriteRule ^newsimg/(.+)$ cpadmin/postpic/image/$1 [NC,L]
RewriteRule ^newstimg/(.+)$ cpadmin/postpic/_thumbs/Images/$1 [NC,L]



RewriteRule ^project/([0-9]+).pdf+$ pdf.php?action=projects&productID=$1 [L]
RewriteRule ^project/([0-9]+).json+$ json.php?action=projects&productID=$1 [L]
RewriteRule ^project/([0-9]+)(/?)+$ index.php?incPageType=projects&productID=$1 [L]

RewriteRule ^visualisation/([0-9]+)(/?)+$ index.php?incPageType=visualisation&productID=$1 [L]

RewriteRule ^contactp.json+$ json.php?action=contact [L]

RewriteRule ^news/view/([0-9]+).json+$ json.php?action=newsmore&newsID=$1 [L]
RewriteRule ^news.json+$ json.php?action=news&$1 [QSA]
RewriteRule ^leadership.json+$ json.php?action=leadership&$1 [QSA]
RewriteRule ^xml.xml+$ xml.php?action=news&$1 [QSA]
RewriteRule ^news/([0-9]+)(/?)+$ index.php?incPageType=news&newsID=$1 [L]

RewriteRule ^clientarea/([^/]+)(/?)+$ index.php?incPageType=clientarea&subPage=$1&$2 [l,QSA]
RewriteRule ^clientfile/([0-9]+)(/?)+$ index.php?incPageType=clientarea&subPage=filedownload&fileID=$1 [L]

RewriteRule ^pics/([A-Z,a-z]+)/([^/]+)(/?) cpadmin/postpic/$1/$2 [NC,L]


RewriteRule ^css/(.*) skin/new/css/$1 [L]  


RewriteRule ^modu/([^/]+)/([^/]+)/([0-9]+)(/?)+$ module.php?action=$1&$2=$3 [L]
RewriteRule ^modu/([^/]+)/([^/]+)/([0-9]+)/(.*)+$ module.php?action=$1&$2=$3&$4 [QSA]
RewriteRule ^modu/([^/]+)/([0-9]+)(/?)+$ module.php?action=$1&objID=$2 [L]
RewriteRule ^modu/([^/]+)(/?)+$ module.php?action=$1 [L]

RewriteRule ^smodu/([^/]+)/([^/]+)/([0-9]+)(/?)+$ smodule.php?action=$1&$2=$3 [L]
RewriteRule ^smodu/([^/]+)/([^/]+)/([0-9]+)/(.*)+$ smodule.php?action=$1&$2=$3&$4 [QSA]
RewriteRule ^smodu/([^/]+)(/?)+$ smodule.php?action=$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?incPageType=$1 [L,QSA]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php80” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
